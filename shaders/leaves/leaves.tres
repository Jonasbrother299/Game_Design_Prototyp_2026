[gd_resource type="Shader" format=3 uid="uid://s86vd8ar5cut"]

[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_lambert, specular_disabled, depth_prepass_alpha;

uniform sampler2D WindNoise : repeat_enable, filter_linear;
uniform sampler2D LeaveTexture;
uniform vec3 foliage_colour1 : source_color = vec3(0.13, 0.33, 0.25) ;
uniform vec3 foliage_colour2 : source_color = vec3(0.13, 0.33, 0.25) ;
uniform float wind_speed : hint_range(0.0, 2.0, 0.01) = 1.0;
uniform float wind_strength : hint_range(0.0, 0.2, 0.005) = 0.20;
uniform float foliage_saturation : hint_range(0.0, 1.0, 0.01) = 1.0;
uniform float backlight_strength : hint_range(0.0, 1.0, 0.01) = 0.20;
instance uniform float birch_proximity_fade : hint_range(0.0, 1.0) = 0.0;

uniform float fade_start : hint_range(-1.0, 1.0) = 0.0;
uniform float fade_end   : hint_range(-1.0, 1.0) = 0.5;
varying vec3 instance_pos;

float screen_dither_threshold(vec2 pixel_position) {
	vec2 pixel = floor(pixel_position);
	return fract(
		52.9829189 *
		fract(dot(pixel, vec2(0.06711056, 0.00583715))));
}



void vertex() {
	if (!IN_SHADOW_PASS) {
		vec3 world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
		float wind_time = TIME * wind_speed;
		float phase = dot(world_position.xz, vec2(0.31, 0.23));
		vec2 wind_uv = world_position.xz * 0.035 +
			vec2(wind_time * 0.025, wind_time * 0.018);
		float wind_noise = texture(WindNoise, wind_uv).r * 2.0 - 1.0;
		float sway = sin(wind_time + phase) * 0.7 + wind_noise * 0.3;
		vec3 world_offset = vec3(1.0, 0.12, 0.45) * sway * wind_strength;
		VERTEX += inverse(mat3(MODEL_MATRIX)) * world_offset;
	}
	instance_pos = MODEL_MATRIX[3].xyz;
}

void fragment() {
	float proximity_fade =
		clamp(birch_proximity_fade, 0.0, 1.0);
	if (!IN_SHADOW_PASS && screen_dither_threshold(FRAGCOORD.xy) < proximity_fade)
		discard;

// Texture2D:3

	vec3 normal = normalize(NORMAL);
	
	vec3 to_camera = normalize(CAMERA_POSITION_WORLD - NODE_POSITION_WORLD);
	
	float facing = dot(normal, to_camera);

	vec4 n_out3p0 = texture(LeaveTexture, UV);
	float n_out3p4 = n_out3p0.a;


// ColorConstant:5
	vec4 n_out5p0 = vec4(0.364946, 0.643970, 0.000000, 1.000000);


// ColorConstant:4
	vec4 n_out4p0 = vec4(0.124764, 0.214166, 0.000000, 1.000000);


	float colour_mix = 0.5 + 0.5 * sin(dot(instance_pos.xz, vec2(0.37, 0.61)));
	vec3 n_out6p0 = mix(foliage_colour1, foliage_colour2, colour_mix);


// VectorOp:7
	vec3 n_out7p0 = vec3(n_out3p0.xyz) * n_out6p0;
	
	float alpha = smoothstep(fade_start, fade_end, (facing * -1.0));

// Output:0
	float luminance = dot(n_out7p0, vec3(0.2126, 0.7152, 0.0722));
	ALBEDO = mix(vec3(luminance), n_out7p0, foliage_saturation);
	SPECULAR = 0.0;
	BACKLIGHT = vec3(backlight_strength);
	ALPHA = n_out3p4;
	ALPHA_SCISSOR_THRESHOLD = 0.1;


}
"
